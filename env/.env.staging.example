# Emporio B2B — contrato de ambiente STAGING (valores reais somente no Dokploy)
# Este arquivo é um mapa de nomes/placeholders para validar o Compose.
# No Dokploy, distribua variáveis por serviço; nunca injete este arquivo inteiro.
# Nunca copie valores de prod/dev e nunca versione um `.env` real.

# Imagens GHCR: usar referências imutáveis SHA/digest com manifest ARM64+AMD64.
BACKEND_IMAGE=ghcr.io/emporiob2b/backend-java:__SET_STAGING_SHA__
FRONT_IMAGE=ghcr.io/emporiob2b/front-angular:__SET_STAGING_SHA__
RADAR_IMAGE=ghcr.io/emporiob2b/radar-middleware:__SET_STAGING_SHA__
POSTGRES_IMAGE=postgres:17-alpine@sha256:e5d2edd28b1f8d40a0a6c0c9cdc545b19b56a0d5d88f94bc11a97d970d4700d0
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.7@sha256:4955524aeaa379e154023d5a027c250f7b35041a2e7e950cf13f144bc9b9c5ba
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0@sha256:63805ebb8d2b3920190daf1cb14a60871b16fd38bed42b857a3182bc621f4996

# PostgreSQL local (admin somente no DB e bootstrap)
POSTGRES_ADMIN_USER=emporio_admin
POSTGRES_ADMIN_PASSWORD=replace-with-staging-postgres-admin-password
SPRING_DATASOURCE_PASSWORD=replace-with-staging-emporio-app-password
SPRING_FLYWAY_PASSWORD=replace-with-staging-emporio-migrator-password

# Backend (runtime; secrets exclusivamente do staging)
APP_JWT_SECRET=replace-with-staging-jwt-secret-at-least-256-bits
APP_CORS_ALLOWED_ORIGINS=https://staging.emporiob2b.com.br
APP_PASSWORD_RESET_BASE_URL=https://staging.emporiob2b.com.br
RADAR_BASE_URL=http://radar:8000
# Spring Duration format (include the unit; bare numbers mean milliseconds).
RADAR_CONNECT_TIMEOUT=10s
RADAR_READ_TIMEOUT=30s
MANAGEMENT_SERVER_ADDRESS=10.254.30.10
APP_AUTH_COOKIE_SECURE=true
APP_EMAIL_ENABLED=true
APP_EMAIL_HEALTH_ENABLED=true
SMTP_HOST=replace-with-staging-smtp-host
SMTP_PORT=587
SMTP_USERNAME=replace-with-staging-smtp-username
SMTP_PASSWORD=replace-with-staging-smtp-password
APP_EMAIL_FROM=replace-with-staging-sender
APP_EMAIL_REPLY_TO=replace-with-staging-reply-to
APP_EMAIL_MEDIA_BASE_URL=https://media-staging.emporiob2b.com.br

# Back → R2 staging (resources/credentials dedicados; confirmar policies reais)
APP_STORAGE_PROVIDER=R2
APP_STORAGE_ALLOW_INSECURE_HTTP=false
APP_STORAGE_READ_WRITE_R2_ENDPOINT=https://replace-with-account.r2.cloudflarestorage.com
APP_STORAGE_READ_WRITE_R2_ACCESS_KEY_ID=replace-with-staging-back-rw-access-key
APP_STORAGE_READ_WRITE_R2_SECRET_ACCESS_KEY=replace-with-staging-back-rw-secret-key
APP_STORAGE_READ_ONLY_R2_ENDPOINT=https://replace-with-account.r2.cloudflarestorage.com
APP_STORAGE_READ_ONLY_R2_ACCESS_KEY_ID=replace-with-staging-back-ro-access-key
APP_STORAGE_READ_ONLY_R2_SECRET_ACCESS_KEY=replace-with-staging-back-ro-secret-key
APP_STORAGE_READ_ONLY_QUARENTENA_R2_ENDPOINT=https://replace-with-account.r2.cloudflarestorage.com
APP_STORAGE_READ_ONLY_QUARENTENA_R2_ACCESS_KEY_ID=replace-with-staging-back-quarantine-ro-access-key
APP_STORAGE_READ_ONLY_QUARENTENA_R2_SECRET_ACCESS_KEY=replace-with-staging-back-quarantine-ro-secret-key
APP_STORAGE_R2_QUARENTENA_BUCKET=replace-with-staging-back-quarantine-bucket
APP_STORAGE_R2_PRIVADO_BUCKET=replace-with-staging-back-private-bucket
APP_STORAGE_R2_PUBLICO_BUCKET=replace-with-staging-back-public-bucket
APP_STORAGE_R2_QUARENTENA_PREFIX=quarantine/
APP_STORAGE_R2_PRIVADO_PREFIX=private/
APP_STORAGE_R2_REGION=auto
APP_STORAGE_R2_PUBLICO_BASE_URL=https://media-staging.emporiob2b.com.br

# Radar → R2 staging (credencial/bucket independentes dos do Backend)
CLOUDFLARE_KEY_ID=replace-with-staging-radar-access-key
CLOUDFLARE_SECRET_KEY=replace-with-staging-radar-secret-key
CLOUDFLARE_URL_ACCESS=https://replace-with-account.r2.cloudflarestorage.com
CLOUDFLARE_BUCKET_NAME=replace-with-staging-radar-bucket
CLOUDFLARE_REGION=auto
CLOUDFLARE_CEP_OBJECT_KEY=cep_uf/cep_uf.parquet
CLOUDFLARE_CEP_MANIFEST_OBJECT_KEY=cep_uf/manifest.json
CLOUDFLARE_ESTABELECIMENTOS_OBJECT_KEY=nucleo_rfb/estabelecimentos.parquet
CLOUDFLARE_EMPRESAS_OBJECT_KEY=nucleo_rfb/empresas.parquet
CLOUDFLARE_SOCIOS_OBJECT_KEY=nucleo_rfb/socios.parquet
CLOUDFLARE_NUCLEO_RFB_MANIFEST_OBJECT_KEY=nucleo_rfb/manifest.json
SQLITE_PATH=/var/lib/radar-middleware/state/radar.sqlite3

# Borda — token é provisionado somente no Dokploy/Secrets Provider.
CLOUDFLARED_TUNNEL_TOKEN=replace-with-staging-cloudflared-tunnel-token

# Observabilidade — métricas (Prometheus → Grafana Cloud via remote_write).
# Stack Grafana Cloud smallmarzipan1294, região prod-sa-east-1. Endpoint
# verificado em 2026-11-13 (HTTP 401 sem auth). URL e instance ID não são
# segredos; o token é que fica somente no painel.
PROMETHEUS_REMOTE_WRITE_URL=https://prometheus-prod-40-prod-sa-east-1.grafana.net/api/prom/push
PROMETHEUS_REMOTE_WRITE_USERNAME=3766316
# Dokploy Compose File Mounts ficam em ../files e precisam ser conectados no
# Compose por volumes: ../files/remote-write-token:/etc/prometheus/remote-write-token:ro
# (token metrics:write; Dokploy File Path=remote-write-token,
# Mount Path=/etc/prometheus/remote-write-token).
# Template: Dokploy File Path=prometheus.template.yml,
# Mount Path=/etc/prometheus/prometheus.template.yml; conteúdo de
# compose/prometheus/prometheus.staging.yml; Compose monta de ../files/ para
# /etc/prometheus/prometheus.template.yml (read-only).
# Bootstrap SQL: Dokploy File Path=roles-bootstrap.sql,
# Mount Path=/bootstrap/roles.sql; conteúdo de
# database/bootstrap/roles.sql; Compose monta para /bootstrap/roles.sql (read-only).
# Logs: provider Grafana Loki no Dokploy (Settings → Logs & Metrics), fora do
# compose: URL https://logs-prod-024.grafana.net, user 1878826, token logs:write
# somente no painel. O Dokploy instala o dokploy-vector no host (push HTTPS).
