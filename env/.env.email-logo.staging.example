# Somente para a ferramenta manual scripts/publish-email-logo-staging.sh.
# Provisionar token R2 exclusivo, restrito a escrita no bucket público de staging.
EMAIL_LOGO_R2_ENDPOINT=https://replace-with-account.r2.cloudflarestorage.com
EMAIL_LOGO_R2_BUCKET=replace-with-staging-public-bucket
EMAIL_LOGO_R2_ACCESS_KEY_ID=replace-with-staging-public-bucket-write-key
EMAIL_LOGO_R2_SECRET_ACCESS_KEY=replace-with-staging-public-bucket-write-secret
