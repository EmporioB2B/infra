# Emporio B2B — env de DESENVOLVIMENTO local (compose/docker-compose.dev.yml)
#
# Copie para `env/.env.dev` e substitua TODO valor `replace-with-*`:
#   cp env/.env.dev.example env/.env.dev
#
# `env/.env.dev` é ignorado pelo git (ver .gitignore) e NUNCA deve ser
# commitado, impresso em log ou copiado para outro lugar. Estes são segredos
# LOCAIS de dev — jamais reutilize um valor daqui em teste real ou produção.
#
# Geração sugerida:
#   senha do postgres   : openssl rand -hex 16
#   APP_JWT_SECRET      : openssl rand -hex 32        (>= 256 bits)
#   access keys (40)    : openssl rand -hex 20        (só A-Za-z0-9, 16-128)
#   secret keys (64)    : openssl rand -hex 32
#
# O rustfs-init do compose REJEITA placeholders (replace-with-*, changeme,
# your-*, etc.) e exige access key alfanumérica 16-128 e par read-only
# diferente do par read-write. Se o stack não subir, leia o log do
# rustfs-init antes de qualquer outra coisa.

# --- Back: datasource (o banco do compose é `postgres`; db/user fixos em
#     emporio/emporio; aqui vai SOMENTE a senha)
SPRING_DATASOURCE_PASSWORD=replace-with-dev-postgres-password

# --- Back: JWT (secret efêmero de dev; produção usa valor próprio, nunca
#     este arquivo)
APP_JWT_SECRET=replac…-32b

# --- RustFS: credenciais do emulador de R2 (leia as regras acima)
RUSTFS_ACCESS_KEY=replac…-rw
RUSTFS_SECRET_KEY=replac…-rw
RUSTFS_READ_ONLY_ACCESS_KEY=replac…-ro
RUSTFS_READ_ONLY_SECRET_KEY=replac…-ro

# --- Back: remetente dos emails capturados pelo Mailpit (localhost:8025).
#     Nada é entregue a caixas reais em dev.
APP_EMAIL_FROM=Emporio B2B dev <no-reply@emporiob2b.com.br>

# --- Back: senha SMTP do Mailpit local. O Mailpit roda com
#     MP_SMTP_AUTH_ACCEPT_ANY (aceita qualquer par usuário/senha), mas o
#     Back NÃO sobe com email habilitado sem senha não-vazia. Qualquer
#     valor aleatório serve: openssl rand -hex 16
SMTP_PASSWORD=replac…word

# ---------------------------------------------------------------------------
# Opcionais (o compose já traz defaults seguros de DEV; sobrescreva apenas
# com propósito documentado):
#   APP_CORS_ALLOWED_ORIGINS   default: http://localhost:4200
#   APP_STORAGE_R2_PUBLICO_BASE_URL     default: vazio (ver comentário longo
#       no compose — validação do Back proíbe path na base; TASK-INFRA-006
#       no repo Backend_Java trata do assunto. NÃO apontar para
#       http://localhost:9000/public-local: o app rejeita e não sobe)
#   APP_EMAIL_MEDIA_BASE_URL            default: http://localhost:9000
#   APP_EMAIL_REPLY_TO                  default: no-reply@emporiob2b.com.br
#   RUSTFS_REGION / RUSTFS_ADDRESS / RUSTFS_CONSOLE_ADDRESS
#   MP_MAX_MESSAGES (mailpit)           default: 500
#   RADAR_LOG_LEVEL                     default: INFO
#   RADAR_READ_TIMEOUT                  default: 10s (o do Back é 1s — curta
#       para a 1ª consulta com DuckDB frio; só aumente, nunca diminua em dev)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Radar: NÃO há credencial de R2 neste arquivo. O serviço `radar` usa
# `env_file` apontando para o `.env` LOCAL do repo Radar (irmão deste repo):
#   ../../Radar_Middleware_Python/.env
# (ou seja, Emporio_git/Radar_Middleware_Python/.env na máquina do operador).
# Esse arquivo contém CLOUDFLARE_KEY_ID/SECRET_KEY/URL_ACCESS do bucket R2
# de TESTE e vive fora deste repo: nunca é lido por agentes, copiado para
# cá nem versionado aqui. `scripts/up-dev.sh` apenas checa a existência dele.
# ---------------------------------------------------------------------------
